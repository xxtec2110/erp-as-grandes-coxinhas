APP_NAME="As Grandes Coxinhas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=as_grandes_coxinhas
DB_USERNAME=postgres
DB_PASSWORD=

ERP_ADMIN_NAME=
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ATTACHMENT_DISK=local
AGENT_MAX_IMAGE_MB=10
AGENT_MAX_DOCUMENT_MB=15
AGENT_MAX_AUDIO_MB=16
AGENT_TEMPORARY_RETENTION_DAYS=7
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Business Platform / Cloud API (preencha somente no ambiente local)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_CLIENT=disabled
WHATSAPP_MEDIA_DOWNLOADER=disabled
WHATSAPP_MAX_SEND_ATTEMPTS=3
WHATSAPP_ALERT_EMAIL=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_MEDIA_DOWNLOAD_ENABLED=false
WHATSAPP_MEDIA_MAX_ATTEMPTS=2
WHATSAPP_MEDIA_TIMEOUT=20
WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_UNKNOWN_CONTACT_AUTO_REPLY=false
WHATSAPP_IDENTITY_RATE_LIMIT_PER_MINUTE=30

AGENT_AI_PROVIDER=fake
AGENT_AI_TEXT_MODEL=
AGENT_AI_VISION_MODEL=
AGENT_AI_DOCUMENT_MODEL=
AGENT_AUDIO_TRANSCRIPTION_PROVIDER=fake
AGENT_AI_MINIMUM_CONFIDENCE=0.70
AGENT_AI_LIVE_TEST_ENABLED=false
AGENT_AI_LIVE_TEST_BUDGET_BRL=0
AGENT_COST_USD_BRL_RATE=
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30
OPENAI_MAX_ATTEMPTS=2
AGENT_AUDIO_TRANSCRIPTION_MODEL=

PDV_ENABLED=false
PDV_PROVIDER=grandchef
PDV_SYNC_ENABLED=false
PDV_IMPORT_ENABLED=false
PDV_SYNC_INTERVAL_MINUTES=
